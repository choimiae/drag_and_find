{
  "name": "drag-and-find",
  "description": "드래그한 단어의 네이버 백과 또는 위키백과 설명을 보여 주는 크롬 확장",
  "private": true,
  "license": "MIT",
  "version": "1.0.6",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:worker": "WXT_LOOKUP_API_URL=https://drag-and-find-lookup.maestro001220.workers.dev wxt",
    "admin:dev": "pnpm admin:build && wrangler dev --config admin/wrangler.jsonc",
    "admin:build": "vite build --config admin/vite.config.ts",
    "admin:preview": "vite --config admin/vite.config.ts --host 127.0.0.1",
    "build": "wxt build",
    "build:dev": "WXT_LOOKUP_API_URL=https://drag-and-find-lookup.maestro001220.workers.dev wxt build",
    "zip": "pnpm worker:check && wxt zip",
    "zip:store": "WXT_LOOKUP_API_URL=https://drag-and-find-lookup.maestro001220.workers.dev pnpm zip",
    "icons": "node scripts/render-icons.mjs",
    "store:images": "wxt build --mode e2e && node scripts/store-images.mjs",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "wxt build --mode e2e && playwright test",
    "worker:check": "node scripts/check-worker.mjs",
    "worker:check:live": "WXT_LOOKUP_API_URL=https://drag-and-find-lookup.maestro001220.workers.dev pnpm worker:check",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0",
    "wxt": "0.21.4"
  }
}
