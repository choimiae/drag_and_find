4 \uc788\ub2e4. \uc8fc\ub85c \ucc28\uac11\uac8c \ud574\uc11c \ub9c8\uc2dc\uc9c0\ub9cc, \ub530\ub73b\ud558\uac8c..."},"714753":{"pageid":714753,"ns":0,"title":"\ube44\ub217\ubc29\uc6b8","extract":"\ube44\ub217\ubc29\uc6b8\uc740 \ube44\ub204\ub85c \uc778\ud574 \ub098\ub294 \ubc29\uc6b8\uc774\ub2e4."},"3716351":{"pageid":3716351,"ns":0,"title":"\uc5b4\uba54\uc774\uc9d5 \ub514\uc9c0\ud138 \uc11c\ucee4\uc2a4","extract":"\u300a\uc5b4\uba54\uc774\uc9d5 \ub514\uc9c0\ud138 \uc11c\ucee4\uc2a4\u300b(\uc601\uc5b4: The Amazing Digital Circus)\ub294 \uae00\ub9ac\uce58 \ud504\ub85c\ub355\uc158\uac00 \uc81c\uc791\ud558\uace0 \uad6c\uc2a4\uc6cd\uc2a4\uac00 \uae30\ud68d \ubc0f \uc81c\uc791\ud55c \ub2e4\ud06c \ucf54\ubbf8\ub514 \uc6f9 \uc2dc\ub9ac\uc988\uc774\ub2e4. Gooseworx\uc758 \uc6d0\uc791\uc744 \uae30\ubc18\uc73c\ub85c \ub9cc\ub4e0 \uc560\ub2c8\uba54\uc774\uc158\uc774\ub2e4.\uc774 \ud504\ub85c\uadf8\ub7a8\uc740 2023\ub144 10\uc6d4 13\uc77c\uc5d0 \uc81c\uc791\uc0ac \uae00\ub9ac\uce58 \ud504\ub85c\ub355\uc158\uc758 \uc720\ud29c\ube0c \ucc44\ub110\uc5d0\uc11c \ucc98\uc74c\uc73c\ub85c \ubc29\uc601\ub418\uc5c8\ub2e4. \ud3c9\ub860\uac00\uc5d0\uac8c \uc560\ub2c8\uba54\uc774\ud305\uacfc \ub2e4\ud06c \ucf54\ubbf8\ub514 \uc694\uc18c\ub85c \uae0d\uc815\uc801 \ud3c9\uac00\ub97c \ubc1b\uc558\uc73c\uba70 1\uc5b5 \ud68c \uc774\uc0c1\uc758 \uc870\ud68c\uc218\ub97c 1\uac1c\uc6d4 \ub9cc\uc5d0 \ub098\ud0c0\ub0b4 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uac00\uc7a5 \ub9ce\uc740 \uc870\ud68c\uc218\ub97c \uae30\ub85d\ud55c \uc778\ub514 \uc560\ub2c8\uba54\uc774\uc158 \ud30c\uc77c\ub7ff\uc73c\ub85c\uc758 \ud30c\uc77c\ub7ff \uc5d0\ud53c\uc18c\ub4dc\uc758 \uc870\ud68c\uc218\ub97c \ub6f0\uc5b4\ub118\uc5c8\ub2e4..."}}}}