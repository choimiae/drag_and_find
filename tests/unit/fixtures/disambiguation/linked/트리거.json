{"batchcomplete":"","query":{"pages":{"3080463":{"pageid":3080463,"ns":0,"title":"Trigger (EP)","extract":"\u300aTrigger\u300b\ub294 2003\ub144\uc5d0 \ubc1c\ub9e4\ub41c \uc778 \ud50c\ub808\uc784\uc988\uc758 \uc74c\ubc18\uc774\ub2e4. \ub274\ud074\ub9ac\uc5b4 \ube14\ub798\uc2a4\ud2b8\uc5d0 \uc758\ud574 \ubc1c\ub9e4\ub418\uc5c8\ub2e4."},"935922":{"pageid":935922,"ns":0,"title":"\ub370\uc774\ud130\ubca0\uc774\uc2a4 \ud2b8\ub9ac\uac70","extract":"\ub370\uc774\ud130\ubca0\uc774\uc2a4 \ud2b8\ub9ac\uac70(database trigger)\ub294 \ub370\uc774\ud130\ubca0\uc774\uc2a4\uc758 \ud2b9\uc815 \ud14c\uc774\ube14\uc774\ub098 \ubdf0\uc5d0 \ud2b9\uc815 \uc774\ubca4\ud2b8\uac00 \ubc1c\uc0dd\ud560 \ub54c\ub9c8\ub2e4 \uc790\ub3d9\uc73c\ub85c \uc2e4\ud589\ub418\ub294 \uc808\ucc28\uc801 \ucf54\ub4dc\uc774\ub2e4. \ud2b8\ub9ac\uac70\ub294 \uc8fc\ub85c \ub370\uc774\ud130\ubca0\uc774\uc2a4 \ub0b4 \uc815\ubcf4\uc758 \ubb34\uacb0\uc131\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ub41c\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc9c1\uc6d0 \ud14c\uc774\ube14\uc5d0 \uc0c8\ub85c\uc6b4 \ub808\ucf54\ub4dc(\uc0c8\ub85c\uc6b4 \ub178\ub3d9\uc790)\uac00 \ucd94\uac00\ub420 \ub54c, \uc138\uae08, \ud734\uac00, \uae09\uc5ec \ud14c\uc774\ube14\uc5d0\ub3c4 \uc0c8\ub85c\uc6b4 \ub808\ucf54\ub4dc\uac00 \uc0dd\uc131\ub418\uc5b4\uc57c \ud55c\ub2e4. \ud2b8\ub9ac\uac70\ub294 \uae30\ub85d \ub370\uc774\ud130\ub97c \ub85c\uadf8\ub85c \ub0a8\uae30\ub294 \ub370\uc5d0\ub3c4 \uc0ac\uc6a9\ub420 \uc218 \uc788\uc73c\uba70, \uc608\ub97c \ub4e4\uc5b4 \uc9c1\uc6d0\uc758 \uc774\uc804 \uae09\uc5ec \uc815\ubcf4\ub97c \ucd94\uc801\ud558\ub294 \ub370 \ud65c\uc6a9\ub41c\ub2e4."},"347535":{"pageid":347535,"ns":0,"title":"\ubc29\uc544\uc1e0","extract":"\ubc29\uc544\uc1e0(Trigger)\ub294 \ud654\uae30\ub97c \uaca9\ubc1c\uc2dc\ud0a4\ub294 \uc7a5\uce58\uc774\ub2e4. \ub300\ubd80\ubd84\uc758 \ubc29\uc544\uc1e0\ub294 \uacf5\ud1b5\uc801\uc73c\ub85c \uac80\uc9c0\ub85c \ub204\ub974\uac8c \ub418\uc5b4 \uc788\ub294 \ub808\ubc84\uc7a5\uce58\ub85c \uad6c\uc131\ub418\uc5b4 \uc788\ub2e4. \ud558\uc9c0\ub9cc \ub2e4\ub978 \uc190\uac00\ub77d\uc744 \uc0ac\uc6a9\ud558\ub294 \ubc29\uc544\uc1e0\ub3c4 \uc788\ub2e4.(M2 \ube0c\ub77c\uc6b0\ub2dd \uba38\uc2e0\uac74\uc774\ub098 \uc2a4\ud504\ub9c1\ud544\ub4dc \uc544\uba38\ub9ac M6 \uc2a4\uce74\uc6b0\ud2b8\uac00 \ub300\ud45c\uc801\uc774\ub2e4.)"},"395353":{"pageid":395353,"ns":0,"title":"\ubc29\uc544\uc1e0 (\ub3d9\uc74c\uc774\uc758)","extract":"\ubc29\uc544\uc1e0\ub294 \ub2e4\uc74c\uc744 \uac00\ub9ac\ud0a8\ub2e4.\n\n\ubc29\uc544\uc1e0\n\ubc29\uc544\uc1e0 \uc804\ub7b5(Trigger stragety)"},"1098196":{"pageid":1098196,"ns":0,"title":"\uc778 \ud50c\ub808\uc784\uc988","extract":"\uc778 \ud50c\ub808\uc784\uc988(\uc601\uc5b4: In Flames)\ub294 \uc2a4\uc6e8\ub374\uc758 \ub370\uc2a4 \uba54\ud0c8 \ubc34\ub4dc\uc774\uc790 \uc5bc\ud130\ub108\ud2f0\ube0c \uba54\ud0c8 \ubc34\ub4dc\uc774\ub2e4."},"3750997":{"pageid":3750997,"ns":0,"title":"\ud2b8\ub9ac\uac70 (\ub137\ud50c\ub9ad\uc2a4 \ub4dc\ub77c\ub9c8)","extract":"\u300a\ud2b8\ub9ac\uac70\u300b(\uc601\uc5b4: Trigger)\ub294 \ub137\ud50c\ub9ad\uc2a4\uc5d0\uc11c 2025\ub144 7\uc6d4 25\uc77c\uc5d0 \uacf5\uac1c\ub41c \ub300\ud55c\ubbfc\uad6d\uc758 \uc561\uc158, \uc7ac\ub09c, \uc2a4\ub9b4\ub7ec \ub4dc\ub77c\ub9c8\ub2e4."},"3944408":{"pageid":3944408,"ns":0,"title":"\ud2b8\ub9ac\uac70 (\ub514\uc988\ub2c8+ \ub4dc\ub77c\ub9c8)","extract":"\u300a\ud2b8\ub9ac\uac70\u300b(\uc601\uc5b4: Unmasked)\ub294 \ub514\uc988\ub2c8+\uc5d0\uc11c 2025\ub144 1\uc6d4 15\uc77c\ubd80\ud130 \uacf5\uac1c\ub41c \ub300\ud55c\ubbfc\uad6d\uc758 \uc624\ud53c\uc2a4 \ucf54\ubbf8\ub514, \uc561\uc158 \uc2a4\ub9b4\ub7ec \ub4dc\ub77c\ub9c8\uc774\ub2e4.\n\n"},"3247319":{"pageid":3247319,"ns":0,"title":"\ud2b8\ub9ac\uac70 (\uc560\ub2c8\uba54\uc774\uc158 \uc81c\uc791\uc0ac)","extract":"\uc8fc\uc2dd\ud68c\uc0ac \ud2b8\ub9ac\uac70(\uc77c\ubcf8\uc5b4: \u682a\u5f0f\u4f1a\u793e\u30c8\u30ea\u30ac\u30fc \uac00\ubd80\uc2dc\ud0a4\uac00\uc774\uc0e4 \ub3c4\ub9ac\uac00[*], \uc601\uc5b4: TRIGGER Inc.)\u