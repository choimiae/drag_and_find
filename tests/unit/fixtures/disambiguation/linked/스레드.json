{"batchcomplete":"","query":{"pages":{"4000654":{"pageid":4000654,"ns":0,"title":"\uae00\ud0c0\ub798","extract":""},"2934115":{"pageid":2934115,"ns":0,"title":"\uba54\ud0c0 \ud50c\ub7ab\ud3fc\uc2a4","extract":"\uba54\ud0c0 \ud50c\ub7ab\ud3fc\uc2a4(\uc601\uc5b4: Meta Platforms Inc.)\ub294 \uba58\ub85c\ud30c\ud06c\uc5d0 \ubcf8\uc0ac\ub97c \ub454 \ubbf8\uad6d\uc758 \ub2e4\uad6d\uc801 \uae30\uc220 \uae30\uc5c5\uc774\ub2e4. \uba54\ud0c0\ub294 \ud398\uc774\uc2a4\ubd81, \uc778\uc2a4\ud0c0\uadf8\ub7a8, \uc2a4\ub808\ub4dc, \uba54\uc2e0\uc800, WhatsApp \ub4f1 \uc5ec\ub7ec \uc8fc\uc694 \uc18c\uc15c \ubbf8\ub514\uc5b4 \ud50c\ub7ab\ud3fc\uacfc \ud1b5\uc2e0 \uc11c\ube44\uc2a4\ub97c \uc18c\uc720 \ubc0f \uc6b4\uc601\ud55c\ub2e4. \uc774 \ud68c\uc0ac\ub294 \uc790\uccb4 \uc0ac\uc774\ud2b8 \ubc0f \uc81c3\uc790\ub97c \uc704\ud55c \uad11\uace0 \ub124\ud2b8\uc6cc\ud06c\ub3c4 \uc6b4\uc601\ud55c\ub2e4. 2023\ub144 \uae30\uc900 \uae30\uc900\uc73c\ub85c \uad11\uace0\ub294 \ucd1d \ub9e4\ucd9c\uc758 97.8%\ub97c \ucc28\uc9c0\ud588\ub2e4.\n\uc774 \ud68c\uc0ac\ub294 \uc6d0\ub798 2004\ub144\uc5d0 \ub354\ud398\uc774\uc2a4\ubd81 \uc8fc\uc2dd\ud68c\uc0ac\ub85c \uc124\ub9bd\ub418\uc5c8\uc73c\uba70, 2005\ub144\uc5d0 \ud398\uc774\uc2a4\ubd81 \uc8fc\uc2dd\ud68c\uc0ac\ub85c \uc774\ub984\uc774 \ubcc0\uacbd\ub418\uc5c8\ub2e4. 2021\ub144\uc5d0\ub294 \uac00\uc0c1 \ubc0f \uc99d\uac15 \ud604\uc2e4 \uae30\uc220\uc744..."},"1883826":{"pageid":1883826,"ns":0,"title":"\uc0ac\ubb3c \uc778\ud130\ub137","extract":""},"3944621":{"pageid":3944621,"ns":0,"title":"\uc2a4\ub808\ub4dc (\uc560\ud50c\ub9ac\ucf00\uc774\uc158)","extract":""},"3214":{"pageid":3214,"ns":0,"title":"\uc2a4\ub808\ub4dc (\ucef4\ud4e8\ud305)","extract":"\ucef4\ud4e8\ud130 \uacfc\ud559\uc5d0\uc11c \uc2e4\ud589 \uc2a4\ub808\ub4dc(thread)\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \uc6b4\uc601\uccb4\uc81c\uc758 \uc77c\ubd80\uc778 \uc2a4\ucf00\uc904\ub7ec\uac00 \ub3c5\ub9bd\uc801\uc73c\ub85c \uad00\ub9ac\ud560 \uc218 \uc788\ub294 \uac00\uc7a5 \uc791\uc740 \ud504\ub85c\uadf8\ub798\ubc0d\ub41c \uba85\ub839\uc5b4 \uc2dc\ud000\uc2a4\uc774\ub2e4. \ub9ce\uc740 \uacbd\uc6b0, \uc2a4\ub808\ub4dc\ub294 \ud504\ub85c\uc138\uc2a4\uc758 \uad6c\uc131 \uc694\uc18c\uc774\ub2e4.\n\ud2b9\uc815 \ud504\ub85c\uc138\uc2a4\uc758 \uc5ec\ub7ec \uc2a4\ub808\ub4dc\ub294 \ubcd1\ub82c\uc801\uc73c\ub85c(\uba40\ud2f0\uc2a4\ub808\ub529 \uae30\ub2a5\uc744 \ud1b5\ud574) \uc2e4\ud589\ub420 \uc218 \uc788\uc73c\uba70, \uba54\ubaa8\ub9ac\uc640 \uac19\uc740 \ub9ac\uc18c\uc2a4\ub97c \uacf5\uc720\ud558\uc9c0\ub9cc, \uc11c\ub85c \ub2e4\ub978 \ud504\ub85c\uc138\uc2a4\ub294 \uc774\ub7ec\ud55c \ub9ac\uc18c\uc2a4\ub97c \uacf5\uc720\ud558\uc9c0 \uc54a\ub294\ub2e4. \ud2b9\ud788 \ud504\ub85c\uc138\uc2a4\uc758 \uc2a4\ub808\ub4dc\ub4e4\uc740 \uc2e4\ud589 \uac00\ub2a5\ud55c \ucf54\ub4dc\uc640 \ub3d9\uc801 \ud560\ub2f9\ub41c \ubcc0\uc218 \uac12, \uc2a4\ub808\ub4dc \ub85c\uceec\uc774 \uc544\ub2cc \uc804\uc5ed \ubcc0\uc218\ub4e4\uc744 \ud2b9\uc815 \uc2dc\uc810\uc5d0 \uacf5\uc720\ud55c\ub2e4.\n\uc2a4\ub808\ub4dc\uc640 \ud504\ub85c\uc138\uc2a4\uc758 \uad6c\ud604 \ubc29\uc2dd\uc740..."},"2607725":{"pageid":2607725,"ns":0,"title":"\uc2a4\ub808\ub4dc (\ud1b5\uc2e0 \ud504\ub85c\ud1a0\ucf5c)","extract":"\uc2a4\ub808\ub4dc(thread)\ub294 IoT \uc81c\ud488\uc744 \uc704\ud55c IPV6 \uae30\ubc18\uc758 \uc800\uc804\ub825 \uba54\uc2dc \ub124\ud2b8\uc6cc\ud06c \uae30\uc220\ub85c\uc11c, \uc548\uc804\ud558\uace0 \ubbf8\ub798\uc5d0\ub3c4 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub3c4\ub85d \uace0\uc548\ub418\uc5c8\ub2e4. \uc2a4\ub808\ub4dc \ud504\ub85c\ud1a0\ucf5c \uc0ac\uc591\uc740 \ubb34\ub8cc\ub85c \uc774\uc6a9\uc774 \uac00\ub2a5\ud558\uc9c0\ub9cc \"\uc2a4\ub808\ub4dc \uadf8\ub8f9\uc758 \ud68c\uc6d0\uc740 \uc2a4\ub808\ub4dc \uae30\uc220\uacfc \uc2a4\ub808\ub4dc \uadf8\ub8f9 \uc0ac\uc591\uc758 \uad6c\ud604, \uc2e4\ud589, \ucd9c\ud558\uac00 \ud544\uc694\ud558\ub2e4\"\ub294 EULA\uc758 \uc900\uc218\uc5d0 \ub3d9\uc758\ud558\uc5ec\uc57c \ud55c\ub2e4. \ud559\uc220 \ud2f0\uc5b4(tier)\ub97c \uc81c\uc678\ud55c \uc2a4\ub808\ub4dc \uadf8\ub8f9\uc758 \ud68c\uc6d0\uc740 \uc5f0\uac04 \ud68c\uc6d0\ube44\ub97c \ub0b4\uc57c \ud55c\ub2e4.\n2014\ub144 7\uc6d4, \uc2a4\ub808\ub4dc \uadf8\ub8f9 \uc5f0\ud569\uccb4\uac00 \ubc1c\ud45c\ub418\uc5c8\uc73c\uba70 \uc774\ub294 \uc81c\ud488\uc744 \uc704\ud55c \uc2a4\ub808\ub4dc \uc778\uc99d\uc744 \uc81c\uacf5\ud568\uc73c\ub85c\uc368 \uc2a4\ub808\ub4dc\uac00 \uc0b0\uc5c5 \ud45c\uc900\uc774 \ub420 \uc218 \uc788\ub3c4\ub85d, \ub124\uc2a4\ud2b8 \ub7a9\uc2a4..."},"1078647":{"pageid":1078647,"ns":0,"title":"\uc2a4\ub808\ub4dc \ud50c\ub85c\ud2b8\ud615 \uac8c\uc2dc\ud310","extract":"\uc2a4\ub808\ub4dc \ud50c\ub85c\ud2b8\ud615 \uac8c\uc2dc\ud310\uc740 \uc804\uc790 \uac8c\uc2dc\ud310 \ud615\ud0dc \uc911 \ud558\ub098\uc774\ub2e4."},"3221702":{"pageid":3221702,"ns":0,"title":"\uc2e4\uac00\ub2e5","extract":"\uc2e4\uac00\ub2e5\uc740 \ud754\ud788 \ubc14\ub290\uc9c8\uc5d0 \uc0ac\uc6a9\ub418\ub294 \uc2e4\uc758 \uac00\ub2e5\uc774\ub2e4. \uba74\uc12c\uc720, \ubaa8\uc12c\uc720, \uc544\ub9c8\ud3ec, \ub098\uc77c\ub860, \uacac\uc12c\uc720\ub97c \ud3ec\ud568\ud55c \uac01\uae30 \ub2e4\ub978 \uc218\ub9ce\uc740 \ubb3c\uc9c8\ub85c \uad6c\uc131\ub420 \uc218 \uc788\ub2e4."}}}}