{"batchcomplete":"","query":{"pages":{"-1":{"ns":0,"title":"\ucc3d\uace0\ubc14\uc778\ub354","missing":""},"-2":{"ns":0,"title":"\ud50c\ub7ab\ud3fc (2006\ub144 \uc601\ud654)","missing":""},"-3":{"ns":0,"title":"\ud50c\ub7ab\ud3fc (\uc18c\uc124)","missing":""},"2738109":{"pageid":2738109,"ns":0,"title":"\ub354 \ud50c\ub7ab\ud3fc","extract":"\u300a\ub354 \ud50c\ub7ab\ud3fc\u300b(\uc2a4\ud398\uc778\uc5b4: El Hoyo)\uc740 2019\ub144 \uacf5\uac1c\ub41c \uc2a4\ud398\uc778\uc758 SF, \uc2a4\ub9b4\ub7ec \uc601\ud654\uc774\ub2e4."},"1411857":{"pageid":1411857,"ns":0,"title":"\ubbf8\uc178 \uc6b0\uc5d8\ubca1","extract":""},"156265":{"pageid":156265,"ns":0,"title":"\uc0dd\uc0b0","extract":"\uc0dd\uc0b0(\u751f\u7523, \uc601\uc5b4: production)\uc740 \ub2e4\uc591\ud55c \ud22c\uc785\ubb3c, \uc989 \uc7ac\ub8cc (\uae08\uc18d, \ub098\ubb34, \uc720\ub9ac \ub610\ub294 \ud50c\ub77c\uc2a4\ud2f1\uacfc \uac19\uc740) \ubc0f \ube44\ubb3c\uc9c8\uc801 \ud22c\uc785\ubb3c (\uacc4\ud68d \ub610\ub294 \uc9c0\uc2dd\uacfc \uac19\uc740)\uc744 \uacb0\ud569\ud558\uc5ec \uc0b0\ucd9c\uc744 \ub9cc\ub4e4\uc5b4\ub0b4\ub294 \uacfc\uc815\uc774\ub2e4. \uc774\uc0c1\uc801\uc73c\ub85c \uc774 \uc0b0\ucd9c\ubb3c\uc740 \uac00\uce58\uac00 \uc788\uc73c\uba70 \uac1c\uc778\uc758 \ud6a8\uc6a9\uc5d0 \uae30\uc5ec\ud558\ub294 \uc7ac\ud654 \ub610\ub294 \uc11c\ube44\uc2a4\uac00 \ub420 \uac83\uc774\ub2e4. \uc0dd\uc0b0\uc5d0 \ucd08\uc810\uc744 \ub9de\ucd98 \uacbd\uc81c\ud559 \ubd84\uc57c\ub294 \uc0dd\uc0b0 \uc774\ub860\uc774\ub77c\uace0 \ubd88\ub9ac\uba70, \uacbd\uc81c\ud559\uc758 \uc18c\ube44(\ub610\ub294 \uc18c\ube44\uc790) \uc774\ub860\uacfc \ubc00\uc811\ud55c \uad00\ub828\uc774 \uc788\ub2e4.\n\uc0dd\uc0b0 \uacfc\uc815\uacfc \uc0b0\ucd9c\uc740 \uc6d0\ub798 \ud22c\uc785\ubb3c(\ub610\ub294 \uc0dd\uc0b0\uc694\uc18c)\uc744 \uc0dd\uc0b0\uc801\uc73c\ub85c \ud65c\uc6a9\ud55c \uc9c1\uc811\uc801\uc778 \uacb0\uacfc\uc774\ub2e4. \ud1a0\uc9c0, \ub178\ub3d9, \uc790\ubcf8, \uae30\uc5c5\uac00 \uc815\uc2e0\uc73c\ub85c \uc54c\ub824\uc9c4..."},"314942":{"pageid":314942,"ns":0,"title":"\uc100\uc2dc","extract":"\uc100\uc2dc(\uc601\uc5b4: chassis)\ub294 \uae30\uacc4\uc758 \ubf08\ub300 \uad6c\uc870\ub97c \ub9d0\ud55c\ub2e4. \uc100\uc2dc\ub294 \uc81c\uc870\ub41c \ubb3c\uccb4\uc758 \ud558\uc911\uc744 \uc9c0\ud0f1\ud558\ub294 \ud504\ub808\uc784\uc6cc\ud06c\ub85c, \uad6c\uc870\uc640 \uae30\ub2a5 \uba74\uc5d0\uc11c \ubb3c\uccb4\ub97c \uad6c\uc870\uc801\uc73c\ub85c \uc9c0\uc9c0\ud55c\ub2e4. \uc100\uc2dc\uc758 \uc608\ub85c\ub294 \ucc28\uccb4\uac00 \uc7a5\ucc29\ub418\ub294 \uc790\ub3d9\ucc28 \ud504\ub808\uc784\uc778 \uc790\ub3d9\ucc28 \ud558\ubd80\uac00 \uc788\ub2e4. \ubc14\ud034, \ubcc0\uc18d\uae30, \ub54c\ub85c\ub294 \uc6b4\uc804\uc11d\uacfc \uac19\uc740 \uad6c\ub3d9 \uc7a5\uce58\uac00 \ud3ec\ud568\ub41c \uacbd\uc6b0 \uc5b4\uc148\ube14\ub9ac\ub294 \ub864\ub9c1 \uc100\uc2dc\ub85c \uc124\uba85\ub41c\ub2e4.\n\uac04\ud639 '\uc0f7\uc2dc'\ub77c\uace0 \uc4f0\ub294 \uc0ac\ub78c\ub4e4\uc774 \uc788\uc73c\ub098 chassis\uc758 \ubc1c\uc74c \uae30\ud638\uac00 [\u02c8\u0283\u00e6si]\uc774\ubbc0\ub85c \uc678\ub798\uc5b4 \ud45c\uae30\ubc95\uc5d0 \ub530\ub77c '\uc100\uc2dc'\ub85c \uc801\ub294\ub2e4."},"115517":{"pageid":115517,"ns":0,"title":"\uc18c\ube44","extract":"\uc18c\ube44(\u6d88\u8cbb, \uc601\uc5b4: consumption)\ub294 \ud604\uc7ac\uc758 \ud544\uc694\uc640 \uc695\uad6c\ub97c \ucda9\uc871\uc2dc\ud0a4\uae30 \uc704\ud574 \uc790\uc6d0\uc744 \uc0ac\uc6a9\ud558\ub294 \uac83\uc744 \ub9d0\ud55c\ub2e4. \uc774\ub294 \ubbf8\ub798 \uc18c\ub4dd \ud68d\ub4dd\uc744 \uc704\ud55c \uc9c0\ucd9c\uc778 \ud22c\uc790\uc640 \ub300\uc870\uc801\uc73c\ub85c \uac04\uc8fc\ub41c\ub2e4. \uc18c\ube44\ub294 \uacbd\uc81c\ud559\uc758 \uc8fc\uc694 \uac1c\ub150\uc774\uba70 \ub2e4\ub978 \ub9ce\uc740 \uc0ac\ud68c \uacfc\ud559\uc5d0\uc11c\ub3c4 \uc5f0\uad6c\ub41c\ub2e4.\n\uacbd\uc81c\ud559\uc790 \ud559\ud30c\ub9c8\ub2e4 \uc18c\ube44\ub97c \ub2e4\ub974\uac8c \uc815\uc758\ud55c\ub2e4. \uc8fc\ub958 \uacbd\uc81c\ud559\uc790\uc5d0 \ub530\ub974\uba74, \uac1c\uc778\uc774 \uc989\uac01\uc801\uc778 \uc0ac\uc6a9\uc744 \uc704\ud574 \uc0c8\ub85c \uc0dd\uc0b0\ub41c \uc7ac\ud654\uc640 \uc11c\ube44\uc2a4\ub97c \ucd5c\uc885 \uad6c\ub9e4\ud558\ub294 \uac83\ub9cc\uc774 \uc18c\ube44\ub97c \uad6c\uc131\ud558\uba70, \ub2e4\ub978 \uc720\ud615\uc758 \uc9c0\ucd9c, \ud2b9\ud788 \uace0\uc815 \ud22c\uc790, \uc911\uac04 \uc18c\ube44, \uc815\ubd80 \uc9c0\ucd9c\uc740 \ubcc4\ub3c4\uc758 \ubc94\uc8fc\uc5d0 \uc18d\ud55c\ub2e4(\uc18c\ube44\uc790 \uc774\ub860 \ucc38\uc870). \ub2e4\ub978 \uacbd\uc81c\ud559\uc790\ub4e4\uc740 \uc18c\ube44\ub97c..."},"93304":{"pageid":93304,"ns":0,"title":"\uc2b9\uac15\uc7a5","extract":"\uc2b9\uac15\uc7a5(\u4e58\u964d\u5834) \ud639\uc740 \ud50c\ub7ab\ud3fc(\uc601\uc5b4: platform)\uc740 \uc804\ucca0\uc5ed\uc774\ub098 \ucca0\ub3c4\uc5ed\uc5d0\uc11c \ud654\ubb3c\uc774\ub098 \uc2b9\uac1d\uc774 \uc5f4\ucc28\uc5d0 \ud0c0\uace0 \ub0b4\ub9ac\uae30 \uc704\ud574 \ub9cc\ub4e0 \uc2dc\uc124\ubb3c\uc774\ub2e4. \ud50c\ub7ab\ud3fc\uc744 \ud3fc\uc73c\ub85c \uc904\uc5ec \ubd80\ub974\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc73c\uba70, \ud50c\ub7ab\ud3fc\uc744 \uc77c\ubcf8\uc5b4\uc2dd\uc73c\ub85c \uc904\uc5ec \ubd80\ub978 \u201c\ud638\ubb34\u201d(\uc77c\ubcf8\uc5b4: \u30db\u30fc\u30e0)\uc5d0\uc11c \uc720\ub798\ud55c \ud648\uc73c\ub85c \ubd80\ub974\ub294 \uacbd\uc6b0\ub3c4 \uc788\uace0, \ub300\ud55c\ubbfc\uad6d\uc5d0\uc11c\ub3c4 '\ud648'\uc774\ub780 \ud45c\uae30\ub85c \ub9ce\uc774 \ud1b5\uc6a9\ub41c\ub2e4. \ucd5c\uadfc \ud3fc\uacfc \ud648\uc740 \ud0c0\ub294 \uacf3\uc73c\ub85c \uc77c\ubd80 \uc21c\ud654\ub418\uc5c8\ub2e4."},"163442":{"pageid":163442,"ns":0,"title":"\uc628\ub77c\uc778","extract":""},"824544":{"pageid":824544,"ns":0,"title":"\uc720\ud1b5","extract":"\uc720\ud1b5(\u6d41\u901a, \ubb38\ud654\uc5b4: \ub958\ud1b5)\uc740 \uc0dd\uc0b0\uc790\uac00 \uc0c1\ud488 \ub4f1\uc744 \uc18c\ube44\uc790\uc5d0\uac8c \ud310\ub9e4 \ud558\ub294 \uac83 \u00b7 \ud654\ud3d0 \u00b7 \uc815\ubcf4\uc758 \ud750\ub984\uc744 \ub73b\ud55c\ub2e4. \uc720\ud1b5\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \uc81c\uc870\uc5c5\uccb4\uc640 \uac19\uc740 \uc0dd\uc0b0\uc790\uc5d0\uc11c 1\ucc28 \ub3c4\ub9e4\uc5c5\uc790\ub85c \uc774\ub3d9\ud558\uba70, \uadf8 \ud6c4 2\ucc28 \ub3c4\ub9e4\uc5c5\uc790, \uc18c\ub9e4\uc5c5\uc790\ub97c \ucc28\ub840\ub85c \uac70\uccd0 \uc18c\ube44\uc790\uc5d0\uac8c \ucd5c\uc885\uc801\uc73c\ub85c \uc804\ub2ec\ub41c\ub2e4."},"67467":{"pageid":67467,"ns":0,"title":"\uc790\ub3d9\ucc28","extract":"\uc790\ub3d9\ucc28(\u81ea\u52d5\u8eca, \uc601\uc5b4: car, automobile)\ub294 \uc5d4\uc9c4\uc5d0\uc11c \ub9cc\ub4e0 \ub3d9\ub825\uc744 \ubc14\ud034\uc5d0 \uc804\ub2ec\ud558\uc5ec \uc9c0\uc0c1\uc5d0\uc11c \uc2b9\uac1d\uc774\ub098 \ud654\ubb3c\uc744 \uc6b4\ubc18\ud558\ub294 \ud0c8\uac83\uc774\ub2e4.\n\uc790\ub3d9\ucc28\ub97c \ub73b\ud558\ub294 \uc601\uc5b4 \ub2e8\uc5b4\uc778 'Car'\ub294 \ub77c\ud2f4\uc5b4 'Carrus' \ub610\ub294 'Carrum'\uc5d0\uc11c \uc654\uace0, \ubbf8\uad6d \uc601\uc5b4 \ub2e8\uc5b4\uc778 'Automobile'\uc740 \uadf8\ub9ac\uc2a4\uc5b4 'Autos'\uc640 \ub77c\ud2f4\uc5b4 'Movere'\uc5d0\uc11c \uc654\ub2e4. \uc989, '\uc2a4\uc2a4\ub85c \uc6c0\uc9c1\uc778\ub2e4'\ub294 \ub73b\uc744 \uac00\uc9c0\uace0 \uc788\ub2e4. \ub300\ud55c\ubbfc\uad6d\uc5d0\ub294 1911\ub144\uc5d0 \ub300\ud55c\uc81c\uad6d\uc758 \ud669\uc81c \uc21c\uc885\uc758 \uc804\uc6a9\ucc28\uc640 \uc870\uc120\ucd1d\ub3c5\ubd80\uc758 \uad00\uc6a9\uc73c\ub85c \ucc98\uc74c \ub4e4\uc5b4\uc654\ub2e4.\n\n"},"2761088":{"pageid":2761088,"ns":0,"title":"\uc9c0\ud558\uc2b9\uac15\uc7a5","extract":""},"47026":{"pageid":47026,"ns":0,"title":"\uc9c0\ud558\ucca0","extract":"\uc9c0\ud558\ucca0(\u5730\u4e0b\u9435, \uc601\uc5b4: metro, underground, subway, tube) \ub610\ub294 \uc9c0\ud558\ucca0\ub3c4(\u5730\u4e0b\u9435\u9053)\ub294 \ub3c4\uc2dc\ucca0\ub3c4\uc758 \uac00\uc7a5 \ub300\ud45c\uc801 \ud615\ud0dc\ub85c, \ub178\uc120 \ub300\ubd80\ubd84\uc774 \uc9c0\ud45c\uba74 \uc544\ub798 \ud130\ub110\uc5d0 \ubd80\uc124\ub418\uc5b4 \uc9c0\uc0c1\uc758 \uad50\ud1b5\uacfc \uc644\uc804\ud558\uac8c \ubd84\ub9ac\ub41c \uc804\uc6a9 \uada4\ub3c4\ub97c \uc0ac\uc6a9\ud558\ub294 \ub300\ub7c9 \uc6b4\uc1a1 \uccb4\uacc4\ub2e4. \uc678\uac01 \uc9c0\uc5ed\uc5d0\uc11c\ub294 \uc9c0\uc0c1 \ub178\uc120\ub3c4 \uc788\uc73c\ub098, \ub3c4\uc2ec\uc9c0\uc5d0\uc11c\ub294 \ub178\uc120\uc774 \uc8fc\ub85c \uc9c0\ud558\uc5d0 \uc788\ub294 \ub3c4\uc2dc \ucca0\ub3c4\uc774\ub2e4. \uc9c0\ud558\ucca0\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \ub3c4\uc2dc \uc9c0\uc5ed\uc5d0 \uac74\uc124\ub418\ub294 \uace0\uc6a9\ub7c9 \ub300\uc911\uad50\ud1b5\uc758 \ud55c \uc720\ud615\uc774\ub2e4. \ubc84\uc2a4\ub098 \ud2b8\ub7a8\uacfc \ub2ec\ub9ac \uace0\uc18d \uad50\ud1b5 \uc2dc\uc2a4\ud15c\uc740 \ubcf4\ud589\uc790\ub098 \ub2e4\ub978 \ucc28\ub7c9\uc774 \uc811\uadfc\ud560 \uc218 \uc5c6\ub294 \ub3c5\uc810\uc801\uc778 \ud1b5\ud589 \uc6b0\uc120\uad8c\uc73c\ub85c \uc6b4\ud589\ub418\ub294 \ucca0\ub3c4..."},"139028":{"pageid":139028,"ns":0,"title":"\ucef4\ud4e8\ud305 \ud50c\ub7ab\ud3fc","extract":"\ucef4\ud4e8\ud305 \ud50c\ub7ab\ud3fc(\uc601\uc5b4: computing platform) \ub610\ub294 \ub514\uc9c0\ud138 \ud50c\ub7ab\ud3fc(digital platform)\uc740 \uc18c\ud504\ud2b8\uc6e8\uc5b4\uac00 \uad6c\ub3d9 \uac00\ub2a5\ud55c \ud558\ub4dc\uc6e8\uc5b4 \uc544\ud0a4\ud14d\ucc98\ub098 \uc18c\ud504\ud2b8\uc6e8\uc5b4 \ud504\ub808\uc784\uc6cc\ud06c(\uc751\uc6a9 \ud504\ub85c\uadf8\ub7a8 \ud504\ub808\uc784\uc6cc\ud06c\ub97c \ud3ec\ud568\ud558\ub294)\uc758 \uc885\ub958\ub97c \uc124\uba85\ud558\ub294 \ub2e8\uc5b4\uc774\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c \ud50c\ub7ab\ud3fc\uc740 \ucef4\ud4e8\ud130\uc758 \uc544\ud0a4\ud14d\ucc98, \uc6b4\uc601 \uccb4\uc81c(OS), \ud504\ub85c\uadf8\ub798\ubc0d \uc5b8\uc5b4, \uadf8\ub9ac\uace0 \uad00\ub828 \ub7f0\ud0c0\uc784 \ub77c\uc774\ube0c\ub7ec\ub9ac \ub610\ub294 GUI\ub97c \ud3ec\ud568\ud55c\ub2e4.\n\ud50c\ub7ab\ud3fc\uc740 \uc751\uc6a9 \uc18c\ud504\ud2b8\uc6e8\uc5b4\ub97c \uc2e4\ud589\ud558\uae30 \uc704\ud574 \uc4f0\uc774\ub294 \ud558\ub4dc\uc6e8\uc5b4\uc640 \uc18c\ud504\ud2b8\uc6e8\uc5b4\uc758 \uacb0\ud569\uc774\ub2e4. \ud50c\ub7ab\ud3fc\uc740 \ud558\ub098\uc758 \uc6b4\uc601 \uccb4\uc81c \ub610\ub294 \ucef4\ud4e8\ud130 \uc544\ud0a4\ud14d\ucc98\ub77c\uace0 \ub2e8\uc21c\ud788 \ub9d0\ud560 \uc218 \uc788\uc73c\uba70 \uadf8 \ub450..."},"3267380":{"pageid":3267380,"ns":0,"title":"\ud50c\ub7ab\ud3fc (2000\ub144 \uc601\ud654)","extract":"\ud50c\ub7ab\ud3fc(Platform)\uc740 \uc911\uad6d\uc5d0\uc11c \uc81c\uc791\ub41c \uc9c0\uc544 \uc7a5 \ucee4 \uac10\ub3c5\uc758 2000\ub144 \uc601\ud654\uc774\ub2e4. \uc655\ud64d\uc6e8\uc774 \ub4f1\uc774 \uc8fc\uc5f0\uc73c\ub85c \ucd9c\uc5f0\ud558\uc600\uace0 \uc774\uce58\uc57c\ub9c8 \uc1fc\uc870 \ub4f1\uc774 \uc81c\uc791\uc5d0 \ucc38\uc5ec\ud558\uc600\ub2e4.\n\n"},"2891025":{"pageid":2891025,"ns":0,"title":"\ud50c\ub7ab\ud3fc (\uc790\ub3d9\ucc28)","extract":"\ud50c\ub7ab\ud3fc, \ub610\ub294 \uc790\ub3d9\ucc28 \ud50c\ub7ab\ud3fc\uc740 \uc11c\uc2a4\ud39c\uc158\uacfc \uc5d4\uc9c4\uacfc \ubcc0\uc18d\uae30 \ub4f1\uc758 \ud30c\uc6cc\ud2b8\ub808\uc778\uc758 \ubc30\uce58, \uc911\ub7c9 \ubc30\ubd84\uacfc \ubb34\uac8c \uc911\uc2ec \ub4f1 \ucc28\ub7c9\uc758 \ud575\uc2ec\uc694\uc18c\ub97c \uad6c\uc131\ud558\ub294 \uad6c\uc870\ubb3c\uc774\ub2e4. \ud50c\ub7ab\ud3fc \uacf5\uc720\ub294 \ucc28\ub7c9\uc758 \uac1c\ubc1c \ube44\uc6a9\uc744 \uc808\uac10\ud558\uace0, \ubcf4\ub2e4 \ud6a8\uc728\uc801\uc778 \uacfc\uc815\uc744 \uac16\ucd9c \uc218 \uc788\ub2e4\ub294 \uc7a5\uc810\uc774 \uc788\ub2e4. \uadf8\ub7ec\ub098 \uac01 \ubaa8\ub378\uc744 \ucc28\ubcc4\ud654\ud560 \ub2a5\ub825\uc744 \uc81c\ud55c\ud558\uace0, \uace0\uc720\ud55c \ud2b9\uc131\uc744 \uc783\uc5b4\ubc84\ub9b4 \uc218 \uc788\ub2e4\ub294 \ub2e8\uc810\uc774 \uc788\ub2e4."}}}}