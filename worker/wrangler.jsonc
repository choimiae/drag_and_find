{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "drag-and-find-lookup",
  "main": "index.ts",
  "compatibility_date": "2026-10-30",
  "secrets": {
    "required": ["NAVER_CLIENT_ID", "NAVER_CLIENT_SECRET"],
  },
  "d1_databases": [
    {
      "binding": "USAGE_DB",
      "database_name": "drag-and-find-usage",
      "database_id": "98c62d05-f81c-4602-a341-98d7964df4f6",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["0 18 * * *"] },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
}
